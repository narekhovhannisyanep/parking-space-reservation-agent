AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT="https://ai-proxy.lab.epam.com/"
OPENAI_API_VERSION="2024-10-21"
# Optional: defaults to DIAL_GPT_LUNA_6 in commons/constants.py.
AZURE_OPENAI_DEPLOYMENT=

# Optional storage settings; paths are relative to the project root.
PARKING_CHROMA_DIRECTORY=".data/chroma"
PARKING_CHROMA_COLLECTION="parking_spaces_v2"
PARKING_SQLITE_PATH=".data/parking.sqlite3"
# Trusted deployment location for both retrieval stores; not selected by user chat.
PARKING_LOCATION_ID="demo-central"
# Embeddings use the Azure endpoint/key/version above, only on ingestion/nonempty search.
# Defaults to DIAL_TEXT_EMBEDDING_3_SMALL and TEXT_EMBEDDING_3_SMALL in commons/constants.py.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_MODEL=

LANGSMITH_API_KEY=
LANGSMITH_PROJECT="parking-space-reservation"
# Traces may contain personal data. Enable only with appropriate access controls.
LANGSMITH_TRACING=false
